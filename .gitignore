# Runtime state normally lives in $GAUSSQUEUE_HOME (~/Library/Application Support/GaussQueue),
# but never commit it if a local run puts it here.
config.json
state.json
overrides.json
*.log
work/
jobs/
tmp/
status/
outbox/
bin/

# Training outputs and Brush's GPU autotune cache (written to the working directory)
*.ply
eval_*/
target/

# Python, editors, macOS
__pycache__/
*.pyc
*.bak
.DS_Store

# Secrets never belong here: SSH keys and per-machine worker settings live outside
# the repo (~/.ssh and $GAUSSQUEUE_HOME/config.json).
*.pem
*.key
id_rsa*
id_ed25519*
*_ed25519
*_ed25519.pub
gaussqueue_pc*
.env
